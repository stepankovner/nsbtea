# НСБ Чай — переменные окружения. Скопируйте в .env и заполните.
# Секреты храните только здесь (на сервере), никогда не коммитьте .env в репозиторий.
# Настройки, которые меняет владелец (проценты, цены доставки, реквизиты), — в админке, а не здесь.

# --- Общие ----------------------------------------------------------------------------------
# dev | staging | production. В production сайт не запустится без обязательных ключей ниже.
ENVIRONMENT=dev
# Случайная строка от 32 символов: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Адрес сайта без слеша в конце (на него ведут ссылки в письмах и возврат после оплаты)
PUBLIC_BASE_URL=http://localhost:3000
# Для Caddy: домены, на которые выпускается HTTPS-сертификат
SITE_ADDRESS=localhost
# Дополнительные домены, которые ведут на основной адрес (PUBLIC_BASE_URL), через запятую с пробелом.
# Боевой сервер: nsbtea.online, www.nsbtea.online. Пусто — без переадресации.
REDIRECT_ADDRESS=

# --- База данных и Redis --------------------------------------------------------------------
POSTGRES_USER=nsb
POSTGRES_PASSWORD=
POSTGRES_DB=nsbtea
# Локальная разработка (в Docker Compose адрес подставляется автоматически)
DATABASE_URL=postgresql+asyncpg://nsb:nsb@localhost:5432/nsbtea
REDIS_URL=redis://localhost:6379/0

# --- Картинки -------------------------------------------------------------------------------
# local — на диске сервера (том media); s3 — в S3-хранилище в РФ (Yandex Object Storage, Selectel…)
MEDIA_STORAGE=local
MEDIA_PUBLIC_URL=/media
S3_ENDPOINT_URL=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_MB=15

# --- Точка Банк: интернет-эквайринг ---------------------------------------------------------
# fake — оплата-заглушка (разработка), sandbox — песочница Точки, production — боевой режим,
# off — эквайринг ещё не подключён: сайт работает, покупатель видит «онлайн-оплата подключается»
# (так сайт открывают на боевом адресе, пока банк проверяет его по заявке — docs/ACQUIRING.md)
TOCHKA_MODE=fake
# JWT-ключ из интернет-банка: «Интеграции и API» → «Подключить» → права
# MakeAcquiringOperation, ReadAcquiringData, ReadCustomerData, ManageWebhookData
TOCHKA_JWT=
# Код клиента и ID торговой точки сайта — подскажет python -m app.cli tochka-info (нужен только JWT).
# ID торговой точки обязателен, если у ИП их несколько (например, ещё витрина Точки)
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
# client_id приложения из интернет-банка — нужен для регистрации вебхука
TOCHKA_CLIENT_ID=
# Способы оплаты на странице Точки: card, sbp, tinkoff (T-Pay), dolyame (Долями) — через запятую,
# только подключённые у торговой точки (проверить: python -m app.cli tochka-info)
TOCHKA_PAYMENT_MODES=card,sbp
PAYMENT_TTL_MINUTES=30

# --- СДЭК -----------------------------------------------------------------------------------
# fake — расчёт-заглушка, sandbox — тестовый контур СДЭК, production — боевой,
# off — договора ещё нет: СДЭК скрыт на сайте
CDEK_MODE=fake
# Ключи из ЛК СДЭК: «Интеграция» → «Ключи API» (для sandbox — публичные тестовые ключи из документации)
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

# --- Telegram-бот (уведомления владельцу, вход покупателей через Telegram) ------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (для кнопки «Войти через Telegram»)
TELEGRAM_BOT_USERNAME=
# Случайная строка: Telegram присылает её с каждым вебхуком, чужие запросы отбрасываются
TELEGRAM_WEBHOOK_SECRET=
# Промежуточный сервер за границей, если api.telegram.org с сервера недоступен (docs/DEPLOY.md,
# «Telegram»), например https://tg.nsbtea.ru. Пусто — запросы к Telegram идут напрямую
TELEGRAM_API_URL=

# --- Почта покупателям ----------------------------------------------------------------------
# console — письма пишутся в лог (разработка), smtp — отправка через SMTP-провайдера
# Почтовый сервис Selectel: SMTP_HOST=smtp.mail.selcloud.ru, SMTP_PORT=1126, SMTP_STARTTLS=true (docs/DEPLOY.md);
# на Selectel VDS только он — порты 465 и 587 там закрыты навсегда
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=НСБ Чай <shop@nsbtea.ru>
SMTP_STARTTLS=true
# Куда придёт ответ покупателя на письмо сайта (Reply-To), например обычный ящик владельца.
# Нужен, если у адреса SMTP_FROM нет почтового ящика (сервис Selectel письма только отправляет)
SMTP_REPLY_TO=

# --- Мониторинг -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Резервные копии ------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
# Отдельный бакет для копий БД и картинок (лучше — у другого провайдера или в другом проекте)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ru-central1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Куда писать, если копия не создалась (chat id разработчика или владельца)
BACKUP_ALERT_CHAT_ID=

# --- Сборка ---------------------------------------------------------------------------------
IMAGE_TAG=latest
